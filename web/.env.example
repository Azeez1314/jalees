# Copy to .env.local and fill in. .env.local is gitignored; never commit real values.

# Neon: project dashboard -> Connect -> pooled connection string
DATABASE_URL=

# Neon Auth: project dashboard -> Auth -> Configuration -> Auth URL
NEON_AUTH_BASE_URL=
# 32+ random characters: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

OPENAI_API_KEY=

# Billing (Stripe). Use TEST-mode keys until launch. See README → Billing setup.
# dashboard.stripe.com/test/apikeys → Secret key (sk_test_…)
STRIPE_SECRET_KEY=
# The $9/month recurring Price you create in test mode (price_…)
STRIPE_PRICE_ID=
# `stripe listen` prints one for local testing (whsec_…); in production, the endpoint's signing secret
STRIPE_WEBHOOK_SECRET=
# Public URL of this app, used for Stripe return links (no trailing slash needed)
APP_URL=http://localhost:3000
